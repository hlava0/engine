#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer CoopMlWeightsBuf {
    float w1[256];
    float w2[256];
};

layout(push_constant, scalar) uniform PushConstants {
    CoopMlWeightsBuf weights;
    uint width;
    uint height;
    float exposure;
    float residual_strength;
} pc;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D in_hdr;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D out_image;

shared float16_t s_w1[256];
shared float16_t s_w2[256];
shared float16_t s_act[256]; // 16 pixels x 16 features
shared float16_t s_out[256]; // 16 pixels x 16 outputs

vec3 aces_tonemap(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3(0.0), vec3(1.0));
}

void main() {
    uint tid = gl_LocalInvocationIndex;

    // Cooperatively load 16x16 weight matrices into shared float16_t memory
    for (uint i = tid; i < 256u; i += 32u) {
        s_w1[i] = float16_t(pc.weights.w1[i]);
        s_w2[i] = float16_t(pc.weights.w2[i]);
    }

    uint tile_x = gl_WorkGroupID.x * 16u;
    uint tile_y = gl_WorkGroupID.y;

    // First 16 threads load the 16x16 activation tile for this 16x1 pixel strip
    vec3 orig_rgb = vec3(0.0);
    bool valid_pixel = false;
    if (tid < 16u) {
        uint px = tile_x + tid;
        uint py = tile_y;
        valid_pixel = (px < pc.width) && (py < pc.height);

        vec3 rgb = vec3(0.0);
        vec3 rgb_l = vec3(0.0);
        vec3 rgb_u = vec3(0.0);
        if (valid_pixel) {
            rgb = max(imageLoad(in_hdr, ivec2(px, py)).rgb, vec3(0.0));
            orig_rgb = rgb;
            ivec2 pl = ivec2(max(int(px) - 1, 0), int(py));
            ivec2 pu = ivec2(int(px), max(int(py) - 1, 0));
            rgb_l = max(imageLoad(in_hdr, pl).rgb, vec3(0.0));
            rgb_u = max(imageLoad(in_hdr, pu).rgb, vec3(0.0));
        }

        vec3 c = clamp(rgb * pc.exposure, vec3(0.0), vec3(16.0));
        float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
        float luma_l = dot(clamp(rgb_l * pc.exposure, vec3(0.0), vec3(16.0)), vec3(0.2126, 0.7152, 0.0722));
        float luma_u = dot(clamp(rgb_u * pc.exposure, vec3(0.0), vec3(16.0)), vec3(0.2126, 0.7152, 0.0722));

        uint base = tid * 16u;
        s_act[base + 0u] = float16_t(c.r);
        s_act[base + 1u] = float16_t(c.g);
        s_act[base + 2u] = float16_t(c.b);
        s_act[base + 3u] = float16_t(luma);
        s_act[base + 4u] = float16_t(log(1.0 + c.r));
        s_act[base + 5u] = float16_t(log(1.0 + c.g));
        s_act[base + 6u] = float16_t(log(1.0 + c.b));
        s_act[base + 7u] = float16_t(max(c.r, max(c.g, c.b)));
        s_act[base + 8u] = float16_t(min(c.r, min(c.g, c.b)));
        s_act[base + 9u] = float16_t(abs(luma - luma_l));
        s_act[base + 10u] = float16_t(abs(luma - luma_u));
        s_act[base + 11u] = float16_t(1.0);
        s_act[base + 12u] = float16_t(0.0);
        s_act[base + 13u] = float16_t(0.0);
        s_act[base + 14u] = float16_t(0.0);
        s_act[base + 15u] = float16_t(0.0);
    }

    barrier();

    // Execute 2-layer 16x16x16 cooperative matrix MLP on subgroup 0
    // (targets NVIDIA Tensor Cores & AMD RDNA3/4 WMMA)
    if (gl_SubgroupID == 0u) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> mat_a;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mat_w1;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mat_w2;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mat_zero =
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));

        coopMatLoad(mat_a, s_act, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mat_w1, s_w1, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mat_w2, s_w2, 0, 16, gl_CooperativeMatrixLayoutRowMajor);

        // Layer 1: hidden = ReLU(X * W1)
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mat_h =
            coopMatMulAdd(mat_a, mat_w1, mat_zero);

        for (int i = 0; i < mat_h.length(); ++i) {
            mat_h[i] = max(mat_h[i], float16_t(0.0));
        }

        // Store hidden layer to shared memory and reload as MatrixUseA for Layer 2
        coopMatStore(mat_h, s_out, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> mat_h_a;
        coopMatLoad(mat_h_a, s_out, 0, 16, gl_CooperativeMatrixLayoutRowMajor);

        // Layer 2: out = hidden * W2
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mat_out =
            coopMatMulAdd(mat_h_a, mat_w2, mat_zero);

        coopMatStore(mat_out, s_out, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    }

    barrier();

    if (tid < 16u && valid_pixel) {
        uint base = tid * 16u;
        vec3 ml_delta = vec3(
            float(s_out[base + 0u]),
            float(s_out[base + 1u]),
            float(s_out[base + 2u])
        );
        vec3 hdr = max(orig_rgb * pc.exposure + pc.residual_strength * ml_delta, vec3(0.0));
        vec3 ldr = aces_tonemap(hdr);
        imageStore(out_image, ivec2(tile_x + tid, tile_y), vec4(ldr, 1.0));
    }
}
