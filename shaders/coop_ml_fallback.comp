#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer CoopMlWeightsBuf {
    float w1[256];
    float w2[256];
};

layout(push_constant, scalar) uniform PushConstants {
    CoopMlWeightsBuf weights;
    uint width;
    uint height;
    float exposure;
    float residual_strength;
} pc;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D in_hdr;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D out_image;

vec3 aces_tonemap(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), vec3(0.0), vec3(1.0));
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.width || gid.y >= pc.height) {
        return;
    }

    vec3 orig_rgb = max(imageLoad(in_hdr, ivec2(gid)).rgb, vec3(0.0));
    vec3 rgb_l = max(imageLoad(in_hdr, ivec2(max(int(gid.x) - 1, 0), int(gid.y))).rgb, vec3(0.0));
    vec3 rgb_u = max(imageLoad(in_hdr, ivec2(int(gid.x), max(int(gid.y) - 1, 0))).rgb, vec3(0.0));

    vec3 c = clamp(orig_rgb * pc.exposure, vec3(0.0), vec3(16.0));
    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float luma_l = dot(clamp(rgb_l * pc.exposure, vec3(0.0), vec3(16.0)), vec3(0.2126, 0.7152, 0.0722));
    float luma_u = dot(clamp(rgb_u * pc.exposure, vec3(0.0), vec3(16.0)), vec3(0.2126, 0.7152, 0.0722));

    float x[16];
    x[0] = c.r;
    x[1] = c.g;
    x[2] = c.b;
    x[3] = luma;
    x[4] = log(1.0 + c.r);
    x[5] = log(1.0 + c.g);
    x[6] = log(1.0 + c.b);
    x[7] = max(c.r, max(c.g, c.b));
    x[8] = min(c.r, min(c.g, c.b));
    x[9] = abs(luma - luma_l);
    x[10] = abs(luma - luma_u);
    x[11] = 1.0;
    x[12] = 0.0;
    x[13] = 0.0;
    x[14] = 0.0;
    x[15] = 0.0;

    float h[16];
    for (int col = 0; col < 16; ++col) {
        float acc = 0.0;
        for (int k = 0; k < 16; ++k) {
            acc += x[k] * pc.weights.w1[k * 16 + col];
        }
        h[col] = max(acc, 0.0);
    }

    vec3 ml_delta = vec3(0.0);
    for (int col = 0; col < 3; ++col) {
        float acc = 0.0;
        for (int k = 0; k < 16; ++k) {
            acc += h[k] * pc.weights.w2[k * 16 + col];
        }
        ml_delta[col] = acc;
    }

    vec3 hdr = max(orig_rgb * pc.exposure + pc.residual_strength * ml_delta, vec3(0.0));
    vec3 ldr = aces_tonemap(hdr);
    imageStore(out_image, ivec2(gid), vec4(ldr, 1.0));
}
